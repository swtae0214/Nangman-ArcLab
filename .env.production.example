# docker-compose.prod.yml(그리고 외부 공개 시 docker-compose.caddy.yml)이 읽는 값.
# 실제 값으로 채운 뒤 .env.production 이름으로 저장할 것 (git에 올리지 말 것).

# NAS에서 Docker로 띄운 PostgreSQL 접속 정보. NAS의 로컬 네트워크 IP(또는 Tailscale 등 VPN IP)로 접속한다.
# 주의: NAS의 Postgres 컨테이너가 외부(다른 호스트) 접속을 허용하도록 포트를 열어뒀어야 한다.
DATABASE_URL="postgresql://archlab:REPLACE_ME@<NAS의_IP>:5432/archlab?schema=public"

# 로그인 세션 쿠키 서명용 — openssl rand -hex 32 로 새로 생성해서 넣을 것 (로컬 개발용 값 재사용 금지).
COOKIE_SECRET="REPLACE_ME"

# GitHub 로그인용 OAuth App — 로컬 개발용(localhost:3000)과는 별개로, 이 서버 주소를 콜백으로 쓰는
# OAuth App을 https://github.com/settings/developers 에서 새로 하나 더 등록해서 나온 값을 넣는다.
# Authorization callback URL은 반드시 "${WEB_ORIGIN}/api/backend/auth/github/callback" 과 똑같아야 한다.
GITHUB_CLIENT_ID="REPLACE_ME"
GITHUB_CLIENT_SECRET="REPLACE_ME"

# 로그인 쿠키/공유 링크(share_token) URL 생성 및 CORS 허용 출처로 쓰인다.
# 외부 인터넷에 공개한다면(docker-compose.caddy.yml 같이 쓰는 경우) 반드시 https:// 로 시작해야
# 로그인이 된다 — 로그인 쿠키가 HTTPS 연결에서만 저장되도록 돼 있기 때문이다.
# 예: "https://archlab.example.com" (도메인 없이 로컬 네트워크에서만 쓸 거라면 "http://<서버_IP>:3000")
WEB_ORIGIN="https://<실제_도메인>"

# docker-compose.caddy.yml(외부 공개용)을 같이 쓸 때만 필요. WEB_ORIGIN과 같은 도메인(https:// 없이).
# 이 도메인의 DNS A 레코드가 이 서버의 공인 IP를 가리키고 있어야 Caddy가 인증서를 발급받을 수 있다.
DOMAIN="<실제_도메인>"

# 와이어가드처럼 이미 암호화된 사설망 안에서만 접속 가능한 서버(= 공인 IP 없음, 도메인/HTTPS도
# 아직 없음)에 "팀 내부 테스트용"으로만 띄울 때 아래 주석을 풀고 false로 설정한다. 이 경우
# WEB_ORIGIN도 "http://<서버의 와이어가드 IP>:3000"처럼 http://로 바꿔야 한다.
# 공개 인터넷에 노출하는 배포에서는 절대 이 값을 쓰지 말 것(비워두면 자동으로 안전하게 켜진다).
# COOKIE_SECURE=false
