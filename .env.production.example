# docker-compose.prod.yml 이 읽는 값. 실제 값으로 채운 뒤 .env.production 이름으로 저장할 것 (git에 올리지 말 것).

# NAS에서 Docker로 띄운 PostgreSQL 접속 정보. NAS의 로컬 네트워크 IP(또는 Tailscale 등 VPN IP)로 접속한다.
# 주의: NAS의 Postgres 컨테이너가 외부(다른 호스트) 접속을 허용하도록 포트를 열어뒀어야 한다.
DATABASE_URL="postgresql://archlab:REPLACE_ME@<NAS의_IP>:5432/archlab?schema=public"

# owner_token 쿠키 서명용 — openssl rand -hex 32 로 새로 생성해서 넣을 것 (로컬 개발용 값 재사용 금지).
COOKIE_SECRET="REPLACE_ME"

# 공유 링크(share_token) URL 생성 및 CORS 허용 출처. 실제 접속 도메인/IP로 바꿀 것.
# 예: 도메인이 있으면 "https://archlab.example.com", 없이 IP로만 접속한다면 "http://<서버_IP>:3000"
WEB_ORIGIN="http://<서버_IP>:3000"
