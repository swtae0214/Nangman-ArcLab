# PostgreSQL (docker-compose.yml 의 db 서비스와 일치해야 함)
POSTGRES_USER=archlab
POSTGRES_PASSWORD=archlab_dev_password
POSTGRES_DB=archlab
POSTGRES_PORT=5432

# apps/api 가 사용하는 DB 접속 문자열
DATABASE_URL="postgresql://archlab:archlab_dev_password@127.0.0.1:5432/archlab?schema=public"

# apps/api
API_PORT=4000
# owner_token 쿠키 서명에 사용 (openssl rand -hex 32 등으로 생성해서 교체할 것)
COOKIE_SECRET=change_me_in_local_env
# 공유 링크(share_token) URL을 만들 때 붙이는 프론트 주소. 배포 시 실제 도메인으로 교체할 것.
WEB_ORIGIN="http://localhost:3000"

# apps/web
# 브라우저에는 절대 노출되지 않는 서버 전용 값 (next.config.ts의 rewrites 프록시가 사용).
# 브라우저는 항상 같은 출처(same-origin)의 /api/backend/* 경로만 호출한다.
API_INTERNAL_URL="http://localhost:4000/api/v1"
